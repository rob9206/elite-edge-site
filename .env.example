# ---- App ----
NODE_ENV=development

# Session cookie encryption (min 32 chars). Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# ---- Database (Postgres) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/elite_edge_ops?schema=public"

# ---- Uniwire payment gateway ----
# UNIWIRE_MODE=stub uses the in-process fake gateway (no network, no keys needed).
# UNIWIRE_MODE=live calls https://api.uniwire.com with the keys below.
UNIWIRE_MODE=stub
UNIWIRE_API_BASE=https://api.uniwire.com
UNIWIRE_API_KEY=
UNIWIRE_API_SECRET=
UNIWIRE_PROFILE_ID=

# Shared secret Uniwire signs webhook callbacks with (used to verify inbound calls).
# For UNIWIRE_MODE=stub this can be any value; the stub signs with it too.
UNIWIRE_WEBHOOK_SECRET=change-me-webhook-secret

# Seed passwords for the two staff accounts (used only by `npm run db:seed`).
SEED_FOTI_PASSWORD=change-me-foti
SEED_STEVE_PASSWORD=change-me-steve
